# Production Environment
# Used for release builds submitted to App Store / Google Play
# SAFE TO COMMIT - Contains no secrets, only placeholders

# AdMob Configuration - Production uses REAL ADS
EXPO_PUBLIC_USE_TEST_ADS=false

# Your AdMob IDs (override in .env file for your actual IDs)
# These are placeholders - replace in your local .env file
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Test Ad Unit IDs (Google's official test ads - SAFE TO SHARE)
# Not used in production, but kept for reference
EXPO_PUBLIC_ADMOB_TEST_ANDROID_BANNER=ca-app-pub-3940256099942544/6300978111
EXPO_PUBLIC_ADMOB_TEST_IOS_BANNER=ca-app-pub-3940256099942544/2934735716

# Developer Features - DISABLED in production
EXPO_PUBLIC_ENABLE_DEV_FEATURES=false
EXPO_PUBLIC_ENABLE_PREMIUM_OVERRIDE=false
