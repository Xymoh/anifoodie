# Environment Variables Template
# Copy this file to .env and fill in your actual values
# 
# This is a template file - commit this to git
# DO NOT commit your actual .env file with real IDs

# RevenueCat Configuration (For In-App Purchases)
# Get these from https://dashboard.revenuecat.com/
# Project Settings → API Keys → SDK API Keys
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_kYPztkhmEayaJcfelJNurmETLqX
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_XXXXXXXXXXXXXXXX

# AdMob Configuration
# Get these from https://apps.admob.com/
EXPO_PUBLIC_USE_TEST_ADS=true
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Test Ad Unit IDs (Google's official test ads - these are safe to share)
EXPO_PUBLIC_ADMOB_TEST_ANDROID_BANNER=ca-app-pub-3940256099942544/6300978111
EXPO_PUBLIC_ADMOB_TEST_IOS_BANNER=ca-app-pub-3940256099942544/2934735716

# Developer Features
