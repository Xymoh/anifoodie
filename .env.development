# Development Environment
# Used during local development and testing
# SAFE TO COMMIT - Uses test ads and placeholder IDs

# RevenueCat Configuration - Development
# Get your SDK API Keys from: https://dashboard.revenuecat.com/
# Project Settings → API Keys → Android (in SDK API Keys section)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_CUmNdueaGzdLLVfihUlraceGOuH
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_XXXXXXXXXXXXXXXX

# AdMob Configuration - Development uses TEST ADS by default
EXPO_PUBLIC_USE_TEST_ADS=true

# AdMob IDs (public identifiers, safe to commit - EAS builds read this file)
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-5706076003529829~1455602146
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-5706076003529829~7711402196
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-5706076003529829/3536622969
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-5706076003529829/7260810204

# Test Ad Unit IDs (Google's official test ads - SAFE TO SHARE)
EXPO_PUBLIC_ADMOB_TEST_ANDROID_BANNER=ca-app-pub-3940256099942544/6300978111
EXPO_PUBLIC_ADMOB_TEST_IOS_BANNER=ca-app-pub-3940256099942544/2934735716

# Developer Features - ENABLED in development
EXPO_PUBLIC_ENABLE_DEV_FEATURES=true
EXPO_PUBLIC_ENABLE_PREMIUM_OVERRIDE=true
